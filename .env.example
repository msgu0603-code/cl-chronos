# ==============================================================================
# CL-CHRONOS: Environment Configuration Template
# Copy this file to .env before running the server: cp .env.example .env
# ==============================================================================
DEBUG=True
SECRET_KEY=django-insecure-cl-chronos-academic-reproducibility-key-change-in-prod
ALLOWED_HOSTS=127.0.0.1,localhost

# Database configuration (Defaults to local SQLite if omitted; supports PostgreSQL)
DATABASE_URL=sqlite:///db.sqlite3

# Optional: DeepSeek API Key for Layer 4 Explainable AI (XAI) post-processing.
# If omitted, CL-CHRONOS automatically uses its deterministic fallback summary.
DEEPSEEK_API_KEY=

# Security & CORS
SECURE_SSL=False
CORS_ALLOW_ALL_ORIGINS=True